{
  "name": "nightsky-relay",
  "main": "worker.js",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY",
        "class_name": "Relay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Relay"
      ]
    }
  ],
  "vars": {
    "RELAY_NAMESPACE": "local-test-space",
    "RELAY_ALLOWED_ORIGINS": "https://tonk.network,null",
    "RELAY_ALLOW_MISSING_ORIGIN": "false",
    "RELAY_AUTH_EPOCH": "local-development-v1"
  },
  "observability": {
    "enabled": false
  }
}
